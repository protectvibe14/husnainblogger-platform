# HusnainBlogger platform — environment variables (Astro).
# Copy to .env for local builds, or set in Vercel dashboard →
# Settings → Environment Variables (then redeploy).

# Google Analytics 4 (GA4) Measurement ID.
# Get this from https://analytics.google.com → Admin → Data Streams
# → your web stream → copy the "Measurement ID" (format: G-XXXXXXXXXX).
# The ID is public by design (it appears in page HTML) — NOT a secret.
# Leave empty to ship pages with NO analytics script at all.
PUBLIC_GA4_MEASUREMENT_ID=
