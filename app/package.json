{
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "astro": "7.3.5",
    "kokoro-js": "^1.2.1"
  },
  "description": "HusnainBlogger.com 500 Mini Tools \u2014 Astro 7 static frontend",
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "name": "husnainblogger-tools",
  "private": true,
  "scripts": {
    "build": "astro build",
    "codegen": "node ../scripts/build-registry.mjs",
    "dev": "astro dev",
    "prebuild": "npm run validate && node ../scripts/validate-ads.mjs && node ../scripts/build-registry.mjs --check && npm run sitemap",
    "preview": "astro preview",
    "validate": "node ../scripts/validate-registry.mjs",
    "validate:full": "node src/lib/registry/validate.ts",
    "sitemap": "node ../scripts/generate-sitemap.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
