---
/**
 * CheckerTemplate.astro — input → pass/warn/fail verdicts with details.
 *
 * Serves toolType: checker (15 tools).
 *
 * Contract: inputs via DS Field components; the TOOL LOGIC SLOT returns a
 * findings table ({ columns: ['Check','Result','Details'], rows }) where
 * Result is one of "Pass" | "Warning" | "Fail" as TEXT (never color-only,
 * a11y 1.4.1). An overall verdict line is rendered from the optional
 * `verdict` text output. Demo honesty rule: the demo performs basic format
 * checks only and says so — it never claims to verify safety or liveness.
 *
 * MA2: replace `demoRun` below with an adapter over
 * app/tools/<category>/<slug>/logic.ts.
 */
import ToolShell from './ToolShell.astro';
import Field from '../components/ui/Field.astro';
import Button from '../components/ui/Button.astro';
import type { ToolInput, ToolOutput } from '../lib/registry/types.ts';
import type { ToolTemplatePropsV1 } from './types.ts';

interface Props extends ToolTemplatePropsV1 {}
const { tool, content, relatedTools = [], freshness } = Astro.props;

/* ---------------- DEMO fallback (MA2: delete when real inputs land) ---------------- */
const DEMO_INPUTS: ToolInput[] = [
  { id: 'url', label: 'URL to check', type: 'url', required: true, placeholder: 'https://example.com/page' },
];
const DEMO_OUTPUTS: ToolOutput[] = [
  { id: 'verdict', label: 'Overall result', type: 'text' },
  { id: 'checks', label: 'Detailed checks', type: 'table' },
];
/* ------------------------------------------------------------------------------------ */

const inputs = tool.inputs?.length ? tool.inputs : DEMO_INPUTS;
const outputs = tool.outputs?.length ? tool.outputs : DEMO_OUTPUTS;

const CONTROL: Record<ToolInput['type'], string> = {
  text: 'text',
  number: 'number',
  select: 'select',
  textarea: 'textarea',
  boolean: 'checkbox',
  date: 'date',
  url: 'url',
  file: 'file',
};

const config = {
  toolId: tool.toolId,
  toolName: tool.name,
  toolType: tool.toolType,
  categorySlug: tool.categorySlug,
  slug: tool.slug,
  inputs,
  outputs,
};
---

<ToolShell tool={tool} content={content} relatedTools={relatedTools} freshness={freshness}>
  <div slot="tool-ui" data-tool-root data-tool-type="checker">
    <!-- DEMO: inputs/outputs below are placeholders. MA2 replaces demoRun in the <script>. -->
    <form data-tool-form novalidate aria-label={`${tool.name} inputs`}>
      <div data-error-summary hidden class="hb-error-summary"></div>

      <div class="hb-field-grid">
        {inputs.map((input) => (
          <Field
            id={`field-${tool.toolId}-${input.id}`}
            name={input.id}
            label={input.label}
            type={CONTROL[input.type] ?? 'text'}
            required={input.required}
            hint={input.placeholder}
            options={input.options}
            min={input.validation?.min}
            max={input.validation?.max}
            rows={input.type === 'textarea' ? 4 : undefined}
            autocomplete={input.type === 'url' ? 'url' : undefined}
          />
        ))}
      </div>

      <div class="hb-form-actions">
        <Button type="submit" variant="primary">Check</Button>
        <Button type="button" variant="secondary" data-action="reset">Reset</Button>
      </div>
    </form>

    <section data-tool-results hidden class="hb-results" aria-label="Check results"></section>

    <div data-tool-fallback hidden class="hb-fallback" role="alert">
      <p><strong>Something went wrong running this tool.</strong> Your inputs were kept.</p>
      <Button type="button" variant="secondary" data-fallback-retry>Try again</Button>
    </div>

    <script type="application/json" data-tool-config set:html={JSON.stringify(config)} />
  </div>
</ToolShell>

<script>
  import { mountToolUI, loadToolRun } from './_tool-runtime.ts';
  import type { ToolRunValues, ToolRunResult } from './types.ts';

  /* ================= TOOL LOGIC SLOT (DEMO — MA2: replace) =================
   * Demo: basic URL format checks ONLY. It does not verify the site is
   * safe, live, or reachable — the UI says so. Real tools return
   * { verdict: string, checks: { columns, rows } }.
   * ======================================================================= */
  function demoRun(values: ToolRunValues): ToolRunResult {
    const raw = String(values.url ?? '').trim();
    if (!raw) return { ok: false, error: 'Enter a URL to check.' };
    let parsed: URL | null = null;
    try {
      parsed = new URL(raw);
    } catch {
      parsed = null;
    }
    const rows: string[][] = [
      ['Valid web address', parsed ? 'Pass' : 'Fail', parsed ? 'The URL parses correctly.' : 'Could not parse this as a URL.'],
      ['Uses HTTPS', parsed?.protocol === 'https:' ? 'Pass' : 'Warning', parsed?.protocol === 'https:' ? 'Connection would be encrypted.' : 'HTTP does not encrypt traffic.'],
      ['Reasonable length', raw.length <= 2048 ? 'Pass' : 'Warning', `${raw.length} characters.`],
      ['No spaces', /\s/.test(raw) ? 'Fail' : 'Pass', /\s/.test(raw) ? 'URLs must not contain spaces.' : 'No spaces found.'],
    ];
    const fails = rows.filter((r) => r[1] === 'Fail').length;
    const warnings = rows.filter((r) => r[1] === 'Warning').length;
    const verdict =
      fails > 0
        ? `Needs attention — ${fails} check${fails === 1 ? '' : 's'} failed.`
        : warnings > 0
          ? `Passed with ${warnings} warning${warnings === 1 ? '' : 's'}.`
          : 'All basic format checks passed.';
    return {
      ok: true,
      values: {
        verdict: `${verdict} (Format checks only — this does not verify the site is safe or live.)`,
        checks: { columns: ['Check', 'Result', 'Details'], rows },
      },
    };
  }

  const configEl = document.querySelector('[data-tool-config]');
  const config = JSON.parse(configEl?.textContent ?? '{}');

  // Batch-1 pilot: use the tool's real logic module when it exists;
  // DEMO runner remains the fallback for tools still pending.
  const realRun = await loadToolRun(config.categorySlug, config.slug);

  mountToolUI({
    root: '[data-tool-root]',
    toolId: config.toolId,
    toolName: config.toolName,
    toolType: config.toolType,
    inputs: config.inputs,
    outputs: config.outputs,
    run: realRun ?? demoRun,
    resultHeading: 'Check results',
  });
</script>
