---
/**
 * GeneratorTemplate.astro — seed inputs → a list of generated text items.
 *
 * Serves toolType: generator (271 tools — the largest archetype).
 *
 * Contract: inputs via DS Field components; the TOOL LOGIC SLOT returns
 * string[] for the list output. Each item renders with its own copy button
 * (unique accessible name per a11y §3.8/R2), plus a "copy all" button,
 * download and share-link actions.
 *
 * MA2: replace `demoRun` below with an adapter over
 * app/tools/<category>/<slug>/logic.ts.
 */
import ToolShell from './ToolShell.astro';
import Field from '../components/ui/Field.astro';
import Button from '../components/ui/Button.astro';
import type { ToolInput, ToolOutput } from '../lib/registry/types.ts';
import type { GeneratorTemplateProps } from './types.ts';

interface Props extends GeneratorTemplateProps {}
const { tool, content, relatedTools = [], maxItems = 50, freshness } = Astro.props;

/* ---------------- DEMO fallback (MA2: delete when real inputs land) ---------------- */
const DEMO_INPUTS: ToolInput[] = [
  { id: 'topic', label: 'Topic', type: 'text', required: true, placeholder: 'e.g. indoor plants' },
  { id: 'count', label: 'How many ideas', type: 'number', required: true, placeholder: 'e.g. 10', validation: { min: 1, max: 20 } },
  { id: 'style', label: 'Title style', type: 'select', required: true, options: ['How-to', 'Listicle', 'Question'] },
];
const DEMO_OUTPUTS: ToolOutput[] = [
  { id: 'items', label: 'Generated titles', type: 'list', description: 'Click Copy on any title to use it.' },
];
/* ------------------------------------------------------------------------------------ */

const inputs = tool.inputs?.length ? tool.inputs : DEMO_INPUTS;
const outputs = tool.outputs?.length ? tool.outputs : DEMO_OUTPUTS;

const CONTROL: Record<ToolInput['type'], string> = {
  text: 'text',
  number: 'number',
  select: 'select',
  textarea: 'textarea',
  boolean: 'checkbox',
  date: 'date',
  url: 'url',
  file: 'file',
};

const config = {
  toolId: tool.toolId,
  toolName: tool.name,
  toolType: tool.toolType,
  categorySlug: tool.categorySlug,
  slug: tool.slug,
  inputs,
  outputs,
  maxItems,
};
---

<ToolShell tool={tool} content={content} relatedTools={relatedTools} freshness={freshness}>
  <div slot="tool-ui" data-tool-root data-tool-type="generator">
    <!-- DEMO: inputs/outputs below are placeholders. MA2 replaces demoRun in the <script>. -->
    <form data-tool-form novalidate aria-label={`${tool.name} inputs`}>
      <div data-error-summary hidden class="hb-error-summary"></div>

      <div class="hb-field-grid">
        {inputs.map((input) => (
          <Field
            id={`field-${tool.toolId}-${input.id}`}
            name={input.id}
            label={input.label}
            type={CONTROL[input.type] ?? 'text'}
            required={input.required}
            hint={input.placeholder}
            options={input.options}
            min={input.validation?.min}
            max={input.validation?.max}
            rows={input.type === 'textarea' ? 4 : undefined}
            step={input.type === 'number' ? '1' : undefined}
            inputMode={input.type === 'number' ? 'numeric' : undefined}
          />
        ))}
      </div>

      <div class="hb-form-actions">
        <Button type="submit" variant="primary">Generate</Button>
        <Button type="button" variant="secondary" data-action="reset">Reset</Button>
      </div>
    </form>

    <section data-tool-results hidden class="hb-results" aria-label="Generated results"></section>

    <div data-tool-fallback hidden class="hb-fallback" role="alert">
      <p><strong>Something went wrong running this tool.</strong> Your inputs were kept.</p>
      <Button type="button" variant="secondary" data-fallback-retry>Try again</Button>
    </div>

    <script type="application/json" data-tool-config set:html={JSON.stringify(config)} />
  </div>
</ToolShell>

<script>
  import { mountToolUI, loadToolRun } from './_tool-runtime.ts';
  import type { ToolRunValues, ToolRunResult } from './types.ts';

  /* ================= TOOL LOGIC SLOT (DEMO — MA2: replace) =================
   * Demo: blog-title idea generator from fixed templates. Works on
   * DEMO_INPUTS above only. Real tools return string[] for the list output.
   * ======================================================================= */
  function demoRun(values: ToolRunValues): ToolRunResult {
    const topic = String(values.topic ?? '').trim();
    const count = Math.min(20, Math.max(1, Math.round(Number(values.count) || 10)));
    const style = String(values.style ?? 'How-to');
    if (!topic) return { ok: false, error: 'Enter a topic first.' };
    const templates: Record<string, string[]> = {
      'How-to': [
        `How to master ${topic} in 30 days`,
        `How to get started with ${topic} (beginner guide)`,
        `How to avoid the 7 biggest ${topic} mistakes`,
      ],
      Listicle: [
        `15 ${topic} ideas you can try this weekend`,
        `9 ${topic} tools worth every penny`,
        `21 ${topic} tips from people who do it daily`,
      ],
      Question: [
        `Is ${topic} worth your time in 2026?`,
        `What nobody tells you about ${topic}`,
        `Why does ${topic} work so well? (explained)`,
      ],
    };
    const bank = templates[style] ?? templates['How-to'];
    const items: string[] = [];
    for (let i = 0; items.length < count; i++) items.push(bank[i % bank.length]);
    return { ok: true, values: { items } };
  }

  const configEl = document.querySelector('[data-tool-config]');
  const config = JSON.parse(configEl?.textContent ?? '{}');

  // Batch-1 pilot: use the tool's real logic module when it exists;
  // DEMO runner remains the fallback for tools still pending.
  const realRun = await loadToolRun(config.categorySlug, config.slug);

  mountToolUI({
    root: '[data-tool-root]',
    toolId: config.toolId,
    toolName: config.toolName,
    toolType: config.toolType,
    inputs: config.inputs,
    outputs: config.outputs,
    run: realRun ?? demoRun,
    resultHeading: 'Generated results',
  });
</script>
