---
/**
 * pages/sitemap-page.astro — Human-readable HTML sitemap.
 * Owner: Site.
 *
 * Lists all main pages, categories, and helps visitors + crawlers.
 * (XML sitemap is at /sitemap.xml for search engines.)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../lib/registry/types";
import { byCategory } from "../data/registry.generated";
import { hubHref, toolHref } from "../../../config/site.config";

const title = "Sitemap | HusnainBlogger";
const description =
  "Browse every page on HusnainBlogger — all tool categories, legal pages, and resources in one place.";

const mainPages = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About Us" },
  { href: "/contact/", label: "Contact" },
  { href: "/tools/search/", label: "Search Tools" },
];

const legalPages = [
  { href: "/privacy-policy/", label: "Privacy Policy" },
  { href: "/terms-and-conditions/", label: "Terms & Conditions" },
  { href: "/disclaimer/", label: "Disclaimer" },
  { href: "/cookies-policy/", label: "Cookie Policy" },
  { href: "/dmca/", label: "DMCA" },
];

const categories = CATEGORIES.map((c) => ({
  name: c.name,
  slug: c.slug,
  count: (byCategory[c.slug] ?? []).length,
  tools: (byCategory[c.slug] ?? []).slice(0, 8),
}));
---

<BaseLayout title={title} description={description} canonical="https://husnainblogger.com/sitemap-page/">
  <main class="hb-sitemap">
    <div class="hb-sitemap__hero">
      <span class="hb-tool-eyebrow">Sitemap</span>
      <h1>Every page, one place.</h1>
      <p>Browse all of HusnainBlogger's pages, tool categories, and resources.</p>
    </div>

    <section class="hb-sitemap__section">
      <h2>Main Pages</h2>
      <ul class="hb-sitemap__links">
        {mainPages.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </section>

    <section class="hb-sitemap__section">
      <h2>Tool Categories</h2>
      <div class="hb-sitemap__cats">
        {categories.map((c) => (
          <div class="hb-sitemap__cat">
            <h3><a href={hubHref(c.slug)}>{c.name} ({c.count})</a></h3>
            <ul>
              {c.tools.map((t: any) => (
                <li><a href={toolHref({ categorySlug: c.slug, slug: t.slug })}>{t.name}</a></li>
              ))}
              {c.count > 8 && (
                <li><a href={hubHref(c.slug)} class="hb-sitemap__more">View all {c.count} →</a></li>
              )}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="hb-sitemap__section">
      <h2>Legal</h2>
      <ul class="hb-sitemap__links">
        {legalPages.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .hb-sitemap {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-20);
  }
  .hb-sitemap__hero { text-align: center; margin-bottom: var(--space-12); }
  .hb-sitemap__hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    margin: var(--space-4) 0 var(--space-3);
  }
  .hb-sitemap__hero p { color: var(--color-muted); font-size: var(--text-lg); }
  .hb-sitemap__section { margin-bottom: var(--space-10); }
  .hb-sitemap__section h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .hb-sitemap__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hb-sitemap__links a {
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .hb-sitemap__links a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .hb-sitemap__cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-6);
  }
  .hb-sitemap__cat h3 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .hb-sitemap__cat h3 a { color: var(--color-text); text-decoration: none; }
  .hb-sitemap__cat h3 a:hover { color: var(--color-accent); }
  .hb-sitemap__cat ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .hb-sitemap__cat ul a { color: var(--color-muted); text-decoration: none; font-size: var(--text-sm); }
  .hb-sitemap__cat ul a:hover { color: var(--color-accent); text-decoration: underline; }
  .hb-sitemap__more { font-weight: 700 !important; color: var(--color-accent) !important; }
</style>
