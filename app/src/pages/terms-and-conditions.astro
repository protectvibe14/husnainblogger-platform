---
/**
 * pages/terms-and-conditions.astro — Terms and Conditions (migrated from WordPress, 2026-10-06).
 * Owner: Blog.
 *
 * Content lives in data/pages/terms-and-conditions.html — editable from the admin panel.
 * Do not paste content directly here; edit the data file instead.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import contentHtml from "../../../data/pages/terms-and-conditions.html?raw";

const title = "Terms and Conditions | HusnainBlogger";
---

<BaseLayout
  title={title}
  description="Terms and Conditions — HusnainBlogger."
  canonical="https://husnainblogger.com/terms-and-conditions/"
  robots="noindex, follow"
>
    <main class="hb-directory">
      <div class="hb-tool-hero">
        <h1 class="hb-tool-title">Terms and Conditions</h1>
      </div>
      <section class="hb-section legal-body" set:html={contentHtml} />
    </main>
</BaseLayout>

<style>
  .legal-body { max-width: var(--content-narrow); margin: 0 auto; }
  .legal-body h2 { font-family: var(--font-display); font-size: var(--text-2xl); margin-top: var(--space-8); }
  .legal-body p, .legal-body li { line-height: var(--leading-loose); margin-bottom: var(--space-4); }
</style>
