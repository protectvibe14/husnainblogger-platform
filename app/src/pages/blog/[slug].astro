---
/**
 * pages/blog/[slug].astro — premium single article page.
 * Owner: Blog.
 *
 * Editorial luxury article: breadcrumb, serif display title,
 * reading meta, featured image, refined typography, related posts,
 * prev/next navigation. Uses layouts/BaseLayout.astro for
 * head/header/footer.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSlot from "../../components/ads/AdSlot.astro";
import { postSlug, postUrl, postAbsoluteUrl, readingTime, formatDate } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({
    params: { slug: postSlug(p) },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} | HusnainBlogger`;

// Related: same category first, then latest others (max 3, exclude self)
const all = (await getCollection("blog")).filter(
  (p) => !p.data.draft && postSlug(p) !== postSlug(post),
);
const related = [
  ...all.filter((p) => p.data.category && p.data.category === post.data.category),
  ...all.filter((p) => !p.data.category || p.data.category !== post.data.category),
].slice(0, 3);

// Prev / next by date
const byDate = [...all, post].sort((a, b) => +new Date(a.data.date) - +new Date(b.data.date));
const idx = byDate.findIndex((p) => postSlug(p) === postSlug(post));
const prev = idx > 0 ? byDate[idx - 1] : null;
const next = idx < byDate.length - 1 ? byDate[idx + 1] : null;
---

<BaseLayout
  title={title}
  description={post.data.description}
  canonical={postAbsoluteUrl(post)}
  ogType="article"
  ogImage={post.data.image ? `https://husnainblogger.com${post.data.image}` : undefined}
  activeNav="blog"
  robots={post.data.noindex ? "noindex, follow" : undefined}
>
  <meta property="article:published_time" content={post.data.date} slot="head" />

  <main class="hb-directory">
    <nav class="hb-breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <article class="blog-article">
      <header class="blog-article__head">
        {post.data.category && <span class="hb-tool-eyebrow">{post.data.category}</span>}
        <h1>{post.data.title}</h1>
        <p class="blog-article__standfirst">{post.data.description}</p>
        <div class="blog-article__meta">
          <span class="blog-article__author">By HusnainBlogger</span>
          <span class="blog-card__dot" aria-hidden="true">·</span>
          <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
          <span class="blog-card__dot" aria-hidden="true">·</span>
          <span>{readingTime(post.body)} min read</span>
        </div>
        {post.data.image && (
          <figure class="blog-article__figure">
            <img src={post.data.image} alt={post.data.title} loading="eager" />
          </figure>
        )}
      </header>

      <AdSlot slot="blog-top" />

      <div class="blog-article__body">
        <Content />
      </div>

      <AdSlot slot="blog-bottom" />

      <footer class="blog-article__foot">
        <div class="blog-author">
          <span class="hb-brand__mark blog-author__mark">H</span>
          <div>
            <strong>HusnainBlogger</strong>
            <p>Practical guides for bloggers, YouTubers, and creators — SEO, content strategy, AI workflows, and monetization.</p>
          </div>
        </div>

        {(prev || next) && (
          <nav class="blog-pager" aria-label="More articles">
            {prev ? (
              <a href={postUrl(prev)} class="blog-pager__link blog-pager__prev">
                <span class="blog-pager__label">← Previous</span>
                <span class="blog-pager__title">{prev.data.title}</span>
              </a>
            ) : <span />}
            {next ? (
              <a href={postUrl(next)} class="blog-pager__link blog-pager__next">
                <span class="blog-pager__label">Next →</span>
                <span class="blog-pager__title">{next.data.title}</span>
              </a>
            ) : <span />}
          </nav>
        )}
      </footer>
    </article>

    {related.length > 0 && (
      <section class="blog-related" aria-label="Related articles">
        <h2 class="blog-related__title">Keep reading</h2>
        <div class="blog-related__grid">
          {related.map((p) => (
            <a href={postUrl(p)} class="blog-related__card">
              {p.data.image && (
                <div class="blog-related__media">
                  <img src={p.data.image} alt={p.data.title} loading="lazy" />
                </div>
              )}
              <div class="blog-related__body">
                {p.data.category && <span class="blog-card__cat">{p.data.category}</span>}
                <h3>{p.data.title}</h3>
                <span class="blog-featured__cta">Read article →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .blog-article {
    max-width: var(--content-narrow);
    margin: 0 auto;
  }
  .blog-article__head {
    text-align: center;
    margin-bottom: var(--space-10);
  }
  .blog-article__head h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, var(--text-5xl));
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    line-height: var(--leading-tight);
    margin: var(--space-4) 0 var(--space-3);
    text-wrap: balance;
  }
  .blog-article__standfirst {
    font-size: var(--text-xl);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    max-width: 42rem;
    margin: 0 auto var(--space-6);
    text-wrap: balance;
  }
  .blog-article__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-8);
  }
  .blog-article__author { font-weight: 600; color: var(--color-text); }
  .blog-article__figure {
    margin: 0 0 var(--space-10);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .blog-article__figure img {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  /* ---- body typography ---- */
  .blog-article__body {
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--color-text);
  }
  /* Drop cap on the first real content paragraph:
     - posts without TOC: the very first paragraph
     - posts with TOC: the paragraph after the first section heading (TOC title + list skipped)
     Content renders without Astro's scoped attribute, so :global() is required. */
  :global(.blog-article__body > p:first-of-type:not(.toc-title)::first-letter),
  :global(.blog-article__body > .toc-title + ul + h2 + p::first-letter) {
    font-family: var(--font-display);
    font-size: 3.4em;
    font-weight: 600;
    float: left;
    line-height: 0.9;
    padding-right: var(--space-2);
    color: var(--color-accent-strong);
  }
  /* ---- table of contents (migrated RankMath TOC block) ----
     Content renders without Astro's scoped attribute, so :global() is required. */
  :global(.blog-article__body .toc-title) {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-widest);
    color: var(--color-accent-strong);
    margin-bottom: var(--space-3);
  }
  :global(.blog-article__body .toc-title + ul) {
    list-style: none;
    padding: var(--space-5) var(--space-6);
    margin: 0 0 var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    font-size: var(--text-base);
  }
  :global(.blog-article__body .toc-title + ul ul) {
    list-style: none;
    padding-left: var(--space-4);
    margin-top: var(--space-2);
  }
  :global(.blog-article__body .toc-title + ul li) { margin-bottom: var(--space-1); }
  :global(.blog-article__body .toc-title + ul li::marker) { content: none; }
  :global(.blog-article__body .toc-title + ul a) {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-border-strong);
  }
  :global(.blog-article__body .toc-title + ul a:hover) {
    color: var(--color-accent-strong);
    border-bottom-color: var(--color-accent-strong);
  }
  .blog-article__body h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .blog-article__body h3 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
  }
  .blog-article__body h4 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
  }
  .blog-article__body p { margin-bottom: var(--space-5); }
  .blog-article__body ul, .blog-article__body ol {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }
  .blog-article__body li { margin-bottom: var(--space-2); }
  .blog-article__body li::marker { color: var(--color-accent-strong); }
  .blog-article__body a {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .blog-article__body a:hover { color: var(--color-accent); }
  .blog-article__body img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin: var(--space-6) 0;
  }
  .blog-article__body blockquote {
    margin: var(--space-8) 0;
    padding: var(--space-5) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-subtle);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    font-style: italic;
    color: var(--color-muted);
  }
  .blog-article__body blockquote p { margin-bottom: 0; }
  .blog-article__body strong { color: var(--color-text); }
  .blog-article__body hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-10) auto;
    max-width: 12rem;
  }
  .blog-article__body table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: var(--text-base);
  }
  .blog-article__body th, .blog-article__body td {
    border: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    text-align: left;
  }
  .blog-article__body th {
    background: var(--color-surface);
    font-weight: 700;
  }
  /* ---- footer: author, pager ---- */
  .blog-article__foot { margin-top: var(--space-12); }
  .blog-author {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .blog-author__mark {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    font-size: var(--text-xl);
  }
  .blog-author p {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-base);
  }
  .blog-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .blog-pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-pager__link:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .blog-pager__next { text-align: right; }
  .blog-pager__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-widest);
    color: var(--color-accent-strong);
  }
  .blog-pager__title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: var(--leading-snug);
  }
  /* ---- related ---- */
  .blog-related {
    max-width: var(--content-wide);
    margin: var(--space-16) auto 0;
  }
  .blog-related__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .blog-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-5);
  }
  .blog-related__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .blog-related__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .blog-related__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
  }
  .blog-related__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .blog-related__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }
  .blog-related__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    margin: 0;
    flex: 1;
  }
  @media (max-width: 640px) {
    .blog-pager { grid-template-columns: 1fr; }
  }
</style>
