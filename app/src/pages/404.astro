---
/**
 * 404.astro — custom "page not found" experience for HusnainBlogger.
 *
 * Astro serves this file automatically with a 404 status for unmatched
 * routes (no extra config needed). Because search engines must not index
 * error pages, robots is set to "noindex, follow" — same policy as
 * search.astro. Per the URL-scheme lock (config/site.config.ts), this file
 * never hardcodes /tools/… paths; all links are built with the helpers.
 */
import { toolHref, hubHref, toolsIndexHref, appPath, canonicalUrl } from "../../../config/site.config";
import BaseLayout from "../layouts/BaseLayout.astro";

// 6 real tools from the site's own "Popular right now" list (index.astro),
// every slug verified to exist under app/tools/ on 2026-10-09.
const popularTools = [
  { name: "Stripe Fee Calculator", slug: "stripe-fee-calculator", categorySlug: "make-money", category: "Make Money", blurb: "Know exactly what you'll receive after Stripe fees." },
  { name: "PayPal Fee Calculator", slug: "paypal-fee-calculator", categorySlug: "make-money", category: "Make Money", blurb: "See PayPal fees before you send or receive money." },
  { name: "Etsy Fee Calculator", slug: "etsy-fee-calculator", categorySlug: "make-money", category: "Make Money", blurb: "Price your Etsy listings for real profit." },
  { name: "YouTube Title Analyzer", slug: "youtube-title-analyzer", categorySlug: "youtube", category: "YouTube", blurb: "Check your titles before you publish." },
  { name: "Hashtag Strength Checker", slug: "hashtag-strength-checker", categorySlug: "instagram", category: "Instagram", blurb: "Score your hashtags before you post." },
  { name: "AI Hook Generator", slug: "ai-hook-generator", categorySlug: "ai-tools", category: "AI Tools", blurb: "Viral hooks for your videos in seconds." },
];

// 8 category hubs (names taken verbatim from CATEGORIES in
// src/lib/registry/types.ts; hrefs built with hubHref).
const hubs = [
  { slug: "youtube", name: "YouTube" },
  { slug: "tiktok", name: "TikTok" },
  { slug: "instagram", name: "Instagram" },
  { slug: "blogging-seo", name: "Blogging SEO & Content" },
  { slug: "make-money", name: "Make-Money & Affiliate" },
  { slug: "ai-tools", name: "AI Tools" },
  { slug: "email-marketing", name: "Email & Blog Marketing" },
  { slug: "video-editing", name: "CapCut & Video Editing" },
];

const searchAction = appPath("/search/"); // search.astro reads ?q= client-side
---

<BaseLayout
  title="Page not found — HusnainBlogger"
  description="This page wandered off, but hundreds of free creator tools are still here. Search HusnainBlogger's tools or browse by category."
  canonical={canonicalUrl("/404/")}
  robots="noindex, follow"
  activeNav={null}
>
  <main class="notfound">
    <section class="notfound__hero" aria-labelledby="notfound-title">
      <span class="hb-tool-eyebrow">Lost, but not for long</span>
      <div class="notfound__digits" aria-hidden="true">404</div>
      <h1 id="notfound-title" class="notfound__title">
        Oops! This page wandered off…
      </h1>
      <p class="notfound__sub">
        It happens — maybe the link got a little too curious and clicked
        itself. The good news: every tool you're looking for is still here,
        free, and one search away.
      </p>

      <form class="notfound__search" role="search" action={searchAction} method="get">
        <label class="notfound__search-label" for="notfound-q">Search all 500+ free tools</label>
        <div class="notfound__search-row">
          <input
            id="notfound-q"
            name="q"
            type="search"
            class="notfound__search-input"
            placeholder="Try “hashtag generator” or “fee calculator”…"
            autocomplete="off"
            required
          />
          <button type="submit" class="hb-btn hb-btn--gold">Search</button>
        </div>
      </form>

      <div class="notfound__actions">
        <a class="hb-btn hb-btn--primary" href={toolsIndexHref()}>Back to homepage</a>
        <a class="hb-btn hb-btn--secondary" href={appPath("/contact/")}>Ask us for help</a>
      </div>
    </section>

    <section class="notfound__section" aria-labelledby="notfound-popular-title">
      <h2 id="notfound-popular-title" class="notfound__section-title">Popular right now</h2>
      <p class="notfound__section-sub">While you're here — these are the tools creators reach for every day.</p>
      <ul class="hb-related">
        {popularTools.map((t) => (
          <li>
            <a href={toolHref({ categorySlug: t.categorySlug, slug: t.slug })}>
              <span class="notfound__tool-name">{t.name}</span>
              <span class="notfound__tool-blurb">{t.blurb}</span>
              <span class="notfound__tool-cat">{t.category}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="notfound__section" aria-labelledby="notfound-hubs-title">
      <h2 id="notfound-hubs-title" class="notfound__section-title">Or browse by category</h2>
      <ul class="hb-category-grid">
        {hubs.map((h) => (
          <li class="hb-category-grid__item">
            <a class="hb-category-card" href={hubHref(h.slug)}>
              <span class="hb-category-card__name">{h.name} Tools</span>
              <span class="hb-category-card__count">Free, no signup</span>
              <span class="hb-category-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-16);
  }
  .notfound__hero {
    text-align: center;
    padding: var(--space-16) 0 var(--space-12);
    max-width: var(--content-narrow);
    margin: 0 auto;
    position: relative;
  }
  .notfound__hero::before {
    content: "";
    position: absolute;
    inset: 0 calc(-1 * var(--space-6));
    background: var(--gradient-hero);
    border-radius: var(--radius-xl);
    z-index: -1;
    opacity: 0.6;
  }
  .notfound__digits {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.5rem, 16vw, 9rem);
    line-height: 1;
    letter-spacing: var(--letter-tight);
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: var(--space-4) 0 0;
  }
  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, var(--text-4xl));
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    line-height: var(--leading-tight);
    margin: var(--space-4) 0;
    color: var(--color-text);
  }
  .notfound__sub {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-8);
  }
  .notfound__search {
    text-align: left;
    max-width: 560px;
    margin: 0 auto var(--space-8);
  }
  .notfound__search-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--letter-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .notfound__search-row {
    display: flex;
    gap: var(--space-3);
  }
  .notfound__search-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    min-height: var(--touch-target);
    font-size: var(--text-base);
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .notfound__search-input:hover { border-color: var(--color-border-strong); }
  .notfound__search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .notfound__section {
    margin-top: var(--space-16);
  }
  .notfound__section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    margin: 0 0 var(--space-2);
    text-align: center;
  }
  .notfound__section-sub {
    text-align: center;
    color: var(--color-muted);
    font-size: var(--text-base);
    margin: 0 0 var(--space-8);
  }
  .hb-related a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .notfound__tool-name {
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .notfound__tool-blurb {
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }
  .notfound__tool-cat {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-widest);
    color: var(--color-accent-strong);
  }
  .hb-category-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-5);
  }
  .hb-category-grid__item { margin: 0; }

  @media (max-width: 640px) {
    .notfound__hero { padding: var(--space-12) 0 var(--space-10); }
    .notfound__search-row {
      flex-direction: column;
    }
    .notfound__search-row .hb-btn { width: 100%; }
  }
</style>
