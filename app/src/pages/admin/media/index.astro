---
/**
 * pages/admin/media/index.astro — media library manager.
 * Owner: Admin.
 *
 * Browse images in app/public/images/, upload new ones,
 * delete, and copy public URLs. All via the GitHub API.
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Media" section="media">
  <div class="admin-toolbar">
    <label class="admin-upload">
      <input type="file" id="media-file" accept="image/*" hidden />
      <span class="admin-btn-gold">+ Upload image</span>
    </label>
    <span class="admin-form__status" id="upload-status"></span>
    <span class="admin-count" id="media-count">Loading…</span>
  </div>

  <div class="admin-grid" id="media-grid"></div>
  <p class="admin-error" id="media-error" hidden></p>

  <script>
    import { listDir, readFile, writeFile, deleteFile } from "../../../lib/admin-github";

    const BASE = "app/public/images";
    const grid = document.getElementById("media-grid")!;
    const count = document.getElementById("media-count")!;
    const err = document.getElementById("media-error")!;
    const uploadStatus = document.getElementById("upload-status")!;
    const fileInput = document.getElementById("media-file") as HTMLInputElement;

    const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const isImage = (n: string) => /\.(png|jpe?g|webp|gif|svg|avif)$/i.test(n);

    async function load() {
      try {
        // Top-level files + wp/ folder
        const [top, wp] = await Promise.all([
          listDir(BASE).catch(() => []),
          listDir(`${BASE}/wp`).catch(() => []),
        ]);
        const files = [
          ...top.filter((f: any) => f.type === "file" && isImage(f.name)).map((f: any) => ({ ...f, folder: "" })),
          ...wp.filter((f: any) => f.type === "file" && isImage(f.name)).map((f: any) => ({ ...f, folder: "wp" })),
        ];
        count.textContent = `${files.length} images`;
        grid.innerHTML = files.map((f: any) => {
          const url = `/images/${f.folder ? f.folder + "/" : ""}${f.name}`;
          return `
          <div class="admin-card" data-path="${esc(f.path)}">
            <div class="admin-card__img"><img src="${esc(url)}" alt="${esc(f.name)}" loading="lazy" /></div>
            <p class="admin-card__name" title="${esc(f.name)}">${esc(f.name)}</p>
            <div class="admin-card__actions">
              <button class="admin-link" data-copy="${esc(url)}">Copy URL</button>
              <button class="admin-link admin-link--danger" data-del="${esc(f.path)}" data-name="${esc(f.name)}">Delete</button>
            </div>
          </div>`;
        }).join("");

        grid.querySelectorAll("[data-copy]").forEach((b) =>
          b.addEventListener("click", async () => {
            const url = (b as HTMLElement).dataset.copy!;
            try {
              await navigator.clipboard.writeText(url);
              (b as HTMLElement).textContent = "Copied!";
              setTimeout(() => ((b as HTMLElement).textContent = "Copy URL"), 1200);
            } catch {
              prompt("Copy this URL:", url);
            }
          })
        );
        grid.querySelectorAll("[data-del]").forEach((b) =>
          b.addEventListener("click", async () => {
            const el = b as HTMLElement;
            if (!confirm(`Delete "${el.dataset.name}"? This cannot be undone.`)) return;
            try {
              const { sha } = await readFile(el.dataset.del!);
              await deleteFile(el.dataset.del!, sha, `Admin: delete image ${el.dataset.name}`);
              el.closest(".admin-card")?.remove();
              count.textContent = `${grid.children.length} images`;
            } catch (ex: any) {
              alert("Delete failed: " + (ex.message ?? ex));
            }
          })
        );
      } catch (ex: any) {
        err.textContent = "Could not load media: " + (ex.message ?? ex);
        err.hidden = false;
        count.textContent = "Failed to load";
      }
    }

    fileInput.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      uploadStatus.textContent = "Uploading…";
      try {
        const buf = await file.arrayBuffer();
        // base64 in chunks (large files)
        const bytes = new Uint8Array(buf);
        let bin = "";
        for (let i = 0; i < bytes.length; i += 8192) {
          bin += String.fromCharCode(...bytes.subarray(i, i + 8192));
        }
        const b64 = btoa(bin);
        const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]/g, "-");
        const path = `${BASE}/wp/${Date.now()}-${safeName}`;
        await writeFile(path, b64, `Admin: upload image ${safeName}`, null, true);
        uploadStatus.textContent = "Uploaded!";
        setTimeout(() => (uploadStatus.textContent = ""), 2000);
        fileInput.value = "";
        load();
      } catch (ex: any) {
        uploadStatus.textContent = "";
        alert("Upload failed: " + (ex.message ?? ex));
      }
    });

    load();
  </script>
</AdminLayout>

<style>
  .admin-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .admin-btn-gold {
    display: inline-block;
    font-weight: 700;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--gradient-gold);
    color: #fff;
    cursor: pointer;
  }
  .admin-count { color: var(--color-muted); margin: 0 0 0 auto; }
  .admin-form__status { color: var(--color-muted); font-size: var(--text-sm); }
  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-4);
  }
  .admin-card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .admin-card__img {
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .admin-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .admin-card__name {
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3) 0;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .admin-card__actions {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  .admin-link {
    color: var(--color-accent-strong);
    font-weight: 600;
    font-size: var(--text-xs);
    background: none; border: none; font: inherit; cursor: pointer; padding: 0;
  }
  .admin-link:hover { text-decoration: underline; }
  .admin-link--danger { color: var(--color-error); }
  .admin-error {
    color: var(--color-error);
    background: var(--color-error-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
</style>
