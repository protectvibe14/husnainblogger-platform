---
/**
 * pages/admin/tools/index.astro — tools inventory manager.
 * Owner: Admin.
 *
 * Search/filter the 576-tool inventory, edit tool metadata,
 * save back to GitHub. v1: metadata editing (name, keywords,
 * category, status). Tool logic files stay code-managed for now.
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Tools" section="tools">
  <div class="admin-toolbar">
    <input type="search" id="tool-search" class="admin-search" placeholder="Search tools by name or keyword…" />
    <div class="admin-toolbar__right">
      <select id="filter-category" class="admin-select"><option value="">All categories</option></select>
      <select id="filter-status" class="admin-select">
        <option value="">All statuses</option>
      </select>
      <span class="admin-count" id="tool-count">Loading…</span>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table" id="tools-table" hidden>
      <thead>
        <tr>
          <th>Tool</th>
          <th>Category</th>
          <th>Type</th>
          <th>Status</th>
          <th class="admin-table__actions">Actions</th>
        </tr>
      </thead>
      <tbody id="tools-body"></tbody>
    </table>
  </div>

  <p class="admin-error" id="tools-error" hidden></p>

  <!-- Edit drawer -->
  <div class="admin-drawer" id="edit-drawer" hidden>
    <div class="admin-drawer__panel">
      <h2 id="drawer-title">Edit tool</h2>
      <form id="tool-form" class="admin-form">
        <label class="admin-field"><span>Name *</span><input type="text" id="t-name" required /></label>
        <label class="admin-field"><span>Slug</span><input type="text" id="t-slug" readonly /></label>
        <label class="admin-field"><span>Category</span><input type="text" id="t-category" list="cat-list" /><datalist id="cat-list"></datalist></label>
        <label class="admin-field"><span>Tool type</span><input type="text" id="t-toolType" /></label>
        <label class="admin-field"><span>Primary keyword</span><input type="text" id="t-primaryKeyword" /></label>
        <label class="admin-field"><span>Secondary keywords (comma separated)</span><input type="text" id="t-secondaryKeywords" /></label>
        <label class="admin-field"><span>Status</span>
          <select id="t-status" class="admin-select"></select>
        </label>
        <label class="admin-field"><span>SEO title (empty = auto)</span><input type="text" id="t-seoTitle" maxlength="60" placeholder="Auto-generated from name" /></label>
        <label class="admin-field"><span>SEO description (empty = auto)</span><input type="text" id="t-seoDescription" maxlength="160" placeholder="Auto-generated" /></label>
        <label class="admin-field admin-field--check">
          <input type="checkbox" id="t-noindex" />
          <span>Noindex (hide from Google + sitemap)</span>
        </label>
        <div class="admin-form__actions">
          <button type="submit" class="admin-btn-gold" id="tool-save">Save</button>
          <button type="button" class="admin-btn-ghost" id="drawer-close">Cancel</button>
          <span class="admin-form__status" id="tool-status"></span>
        </div>
        <p class="admin-error" id="tool-error" hidden></p>
      </form>
    </div>
  </div>

  <script>
    import { readFile, writeFile } from "../../../lib/admin-github";
    import { CONTENT_PATHS } from "../../../lib/admin-config";

    let inventory: any = null;
    let invSha: string | null = null;
    let editingIndex = -1;

    const body = document.getElementById("tools-body")!;
    const table = document.getElementById("tools-table")!;
    const count = document.getElementById("tool-count")!;
    const err = document.getElementById("tools-error")!;
    const search = document.getElementById("tool-search") as HTMLInputElement;
    const fCat = document.getElementById("filter-category") as HTMLSelectElement;
    const fStatus = document.getElementById("filter-status") as HTMLSelectElement;
    const drawer = document.getElementById("edit-drawer")!;

    const esc = (s: any) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    async function load() {
      try {
        const { content, sha } = await readFile(CONTENT_PATHS.toolsInventory);
        invSha = sha;
        inventory = JSON.parse(content);
        const tools = inventory.tools ?? [];

        // Filters
        const cats = [...new Set(tools.map((t: any) => t.category).filter(Boolean))].sort();
        fCat.innerHTML = '<option value="">All categories</option>' + cats.map((c: string) => `<option>${esc(c)}</option>`).join("");
        const statuses = [...new Set(tools.map((t: any) => t.status).filter(Boolean))].sort();
        fStatus.innerHTML = '<option value="">All statuses</option>' + statuses.map((s: string) => `<option>${esc(s)}</option>`).join("");
        (document.getElementById("cat-list") as HTMLElement).innerHTML = cats.map((c: string) => `<option value="${esc(c)}">`).join("");
        (document.getElementById("t-status") as HTMLSelectElement).innerHTML = statuses.map((s: string) => `<option>${esc(s)}</option>`).join("");

        render();
        table.hidden = false;
      } catch (ex: any) {
        err.textContent = "Could not load inventory: " + (ex.message ?? ex);
        err.hidden = false;
      }
    }

    function filtered() {
      const q = search.value.trim().toLowerCase();
      return (inventory.tools ?? []).map((t: any, i: number) => ({ t, i })).filter(({ t }: any) => {
        if (fCat.value && t.category !== fCat.value) return false;
        if (fStatus.value && t.status !== fStatus.value) return false;
        if (q && !`${t.name} ${t.slug} ${t.primaryKeyword}`.toLowerCase().includes(q)) return false;
        return true;
      });
    }

    function statusBadge(s: string) {
      const cls = s === "RELEASED" ? "admin-badge--live" : s === "BUILT" ? "admin-badge--built" : "admin-badge--draft";
      return `<span class="admin-badge ${cls}">${esc(s)}</span>`;
    }

    function render() {
      const rows = filtered().slice(0, 200); // cap for performance
      count.textContent = `${filtered().length} tools${filtered().length > 200 ? " (showing 200)" : ""}`;
      body.innerHTML = rows.map(({ t, i }: any) => {
        const on = t.enabled !== false;
        return `
        <tr class="${on ? "" : "admin-row--off"}">
          <td class="admin-table__title">${esc(t.name)}<br><small class="admin-muted">${esc(t.slug)}</small></td>
          <td>${esc(t.category)}</td>
          <td>${esc(t.toolType)}</td>
          <td>${statusBadge(t.status)}${t.noindex ? ' <span class="admin-badge admin-badge--noindex">noindex</span>' : ""}</td>
          <td class="admin-table__actions">
            <button class="admin-toggle ${on ? "admin-toggle--on" : ""}" data-toggle="${i}" title="${on ? "Turn OFF" : "Turn ON"}" aria-label="${on ? "Turn OFF" : "Turn ON"} ${esc(t.name)}">
              <span class="admin-toggle__knob"></span>
            </button>
            <button class="admin-link" data-edit="${i}">Edit</button>
          </td>
        </tr>`; }).join("");
      body.querySelectorAll("[data-edit]").forEach((b) =>
        b.addEventListener("click", () => openDrawer(Number((b as HTMLElement).dataset.edit)))
      );
      body.querySelectorAll("[data-toggle]").forEach((b) =>
        b.addEventListener("click", () => toggleEnabled(Number((b as HTMLElement).dataset.toggle)))
      );
    }

    async function toggleEnabled(i: number) {
      const t = inventory.tools[i];
      t.enabled = t.enabled === false ? true : false;
      try {
        await writeFile(CONTENT_PATHS.toolsInventory, JSON.stringify(inventory, null, 2), `Admin: ${t.enabled ? "enable" : "disable"} tool "${t.name}"`, invSha);
        const { sha } = await readFile(CONTENT_PATHS.toolsInventory);
        invSha = sha;
        render();
      } catch (ex: any) {
        t.enabled = !t.enabled; // revert on failure
        alert("Toggle failed: " + (ex.message ?? ex));
      }
    }

    function openDrawer(i: number) {
      editingIndex = i;
      const t = inventory.tools[i];
      (document.getElementById("drawer-title") as HTMLElement).textContent = `Edit: ${t.name}`;
      (document.getElementById("t-name") as HTMLInputElement).value = t.name ?? "";
      (document.getElementById("t-slug") as HTMLInputElement).value = t.slug ?? "";
      (document.getElementById("t-category") as HTMLInputElement).value = t.category ?? "";
      (document.getElementById("t-toolType") as HTMLInputElement).value = t.toolType ?? "";
      (document.getElementById("t-primaryKeyword") as HTMLInputElement).value = t.primaryKeyword ?? "";
      const sk = t.secondaryKeywords;
      (document.getElementById("t-secondaryKeywords") as HTMLInputElement).value = Array.isArray(sk) ? sk.join(", ") : String(sk ?? "");
      (document.getElementById("t-status") as HTMLSelectElement).value = t.status ?? "";
      (document.getElementById("t-seoTitle") as HTMLInputElement).value = t.seoTitle ?? "";
      (document.getElementById("t-seoDescription") as HTMLInputElement).value = t.seoDescription ?? "";
      (document.getElementById("t-noindex") as HTMLInputElement).checked = !!t.noindex;
      (document.getElementById("tool-error") as HTMLElement).hidden = true;
      drawer.hidden = false;
    }

    document.getElementById("drawer-close")?.addEventListener("click", () => (drawer.hidden = true));
    drawer.addEventListener("click", (e) => { if (e.target === drawer) drawer.hidden = true; });

    document.getElementById("tool-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const toolErr = document.getElementById("tool-error") as HTMLElement;
      const st = document.getElementById("tool-status") as HTMLElement;
      const btn = document.getElementById("tool-save") as HTMLButtonElement;
      toolErr.hidden = true;
      btn.disabled = true;
      st.textContent = "Saving…";
      try {
        const t = inventory.tools[editingIndex];
        const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
        t.name = v("t-name");
        t.category = v("t-category");
        t.toolType = v("t-toolType");
        t.primaryKeyword = v("t-primaryKeyword");
        t.secondaryKeywords = v("t-secondaryKeywords").split(",").map((s) => s.trim()).filter(Boolean);
        t.status = (document.getElementById("t-status") as HTMLSelectElement).value;
        t.seoTitle = v("t-seoTitle");
        t.seoDescription = v("t-seoDescription");
        t.noindex = (document.getElementById("t-noindex") as HTMLInputElement).checked;
        await writeFile(CONTENT_PATHS.toolsInventory, JSON.stringify(inventory, null, 2), `Admin: edit tool "${t.name}"`, invSha);
        // refresh sha
        const { sha } = await readFile(CONTENT_PATHS.toolsInventory);
        invSha = sha;
        st.textContent = "Saved!";
        render();
        setTimeout(() => { drawer.hidden = true; st.textContent = ""; btn.disabled = false; }, 700);
      } catch (ex: any) {
        toolErr.textContent = "Save failed: " + (ex.message ?? ex);
        toolErr.hidden = false;
        btn.disabled = false;
        st.textContent = "";
      }
    });

    search.addEventListener("input", render);
    fCat.addEventListener("change", render);
    fStatus.addEventListener("change", render);
    load();
  </script>
</AdminLayout>

<style>
  .admin-toolbar {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }
  .admin-search {
    flex: 1;
    min-width: 220px;
    font: inherit;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: var(--color-text);
    color-scheme: light;
  }
  .admin-toolbar__right { display: flex; gap: var(--space-3); align-items: center; }
  .admin-select {
    font: inherit;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: var(--color-text);
    color-scheme: light;
  }
  .admin-count { color: var(--color-muted); font-size: var(--text-sm); margin: 0; white-space: nowrap; }
  .admin-table-wrap {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow-x: auto;
  }
  .admin-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .admin-table th, .admin-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .admin-table th {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-widest);
    color: var(--color-muted);
    background: var(--color-surface);
  }
  .admin-table__title { font-weight: 600; }
  .admin-muted { color: var(--color-muted); font-weight: 400; }
  .admin-table__actions { white-space: nowrap; text-align: right; }
  .admin-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-muted);
  }
  .admin-badge--live { background: var(--color-success-bg); color: var(--color-on-success-bg); }
  .admin-badge--built { background: var(--color-info-bg); color: var(--color-on-info-bg); }
  .admin-badge--draft { background: var(--color-warning-bg); color: var(--color-on-warning-bg); }
  .admin-badge--noindex { background: var(--color-surface); color: var(--color-muted); border: 1px solid var(--color-border); }
  .admin-row--off { opacity: 0.55; }
  .admin-row--off .admin-table__title { text-decoration: line-through; }
  /* ON/OFF toggle switch */
  .admin-toggle {
    position: relative;
    width: 2.5rem;
    height: 1.4rem;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-border-strong);
    cursor: pointer;
    vertical-align: middle;
    margin-right: var(--space-2);
    transition: background 0.2s;
    padding: 0;
  }
  .admin-toggle--on { background: var(--color-success); }
  .admin-toggle__knob {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #fff;
    transition: left 0.2s;
    box-shadow: var(--shadow-sm);
  }
  .admin-toggle--on .admin-toggle__knob { left: 1.25rem; }
  .admin-link {
    color: var(--color-accent-strong);
    font-weight: 600;
    background: none; border: none; font: inherit; cursor: pointer; padding: 0;
  }
  .admin-link:hover { text-decoration: underline; }
  .admin-error {
    color: var(--color-error);
    background: var(--color-error-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
  /* drawer */
  .admin-drawer {
    position: fixed; inset: 0;
    background: rgba(26, 24, 21, 0.5);
    display: flex; justify-content: flex-end;
    z-index: 100;
  }
  .admin-drawer[hidden] { display: none; }
  .admin-drawer__panel {
    background: var(--color-surface-raised);
    width: 100%; max-width: 30rem;
    padding: var(--space-8);
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
  }
  .admin-drawer__panel h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-5);
  }
  .admin-form { display: flex; flex-direction: column; gap: var(--space-4); }
  .admin-field span { display: block; font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2); }
  .admin-field input, .admin-field select {
    width: 100%; font: inherit;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    color: var(--color-text);
    box-sizing: border-box;
    color-scheme: light;
  }
  .admin-field input[readonly] { background: var(--color-surface); color: var(--color-muted); }
  .admin-form__actions { display: flex; gap: var(--space-3); align-items: center; margin-top: var(--space-2); }
  .admin-btn-gold {
    font: inherit; font-weight: 700;
    padding: var(--space-3) var(--space-6);
    border: none; border-radius: var(--radius-lg);
    background: var(--gradient-gold); color: #fff; cursor: pointer;
  }
  .admin-btn-gold:disabled { opacity: 0.6; cursor: wait; }
  .admin-btn-ghost {
    display: inline-block; padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: none; font: inherit; font-weight: 600; color: var(--color-text); cursor: pointer;
  }
  .admin-form__status { color: var(--color-muted); font-size: var(--text-sm); }
</style>
