---
/**
 * pages/admin/pages/index.astro — static pages manager.
 * Owner: Admin.
 *
 * Lists content-managed static pages (legal pages) whose HTML lives
 * in data/pages/*.html. Edit opens the HTML editor.
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";

const MANAGED_PAGES = [
  { slug: "privacy-policy", title: "Privacy Policy", url: "/privacy-policy/" },
  { slug: "terms-and-conditions", title: "Terms and Conditions", url: "/terms-and-conditions/" },
  { slug: "disclaimer", title: "Disclaimer", url: "/disclaimer/" },
  { slug: "cookies-policy", title: "Cookies Policy", url: "/cookies-policy/" },
];
---

<AdminLayout title="Pages" section="pages">
  <p class="admin-note">
    These pages are content-managed — edit their text below. The change goes
    live after the next site deploy. (Homepage, tool and blog pages are
    code-managed and not listed here.)
  </p>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Page</th>
          <th>URL</th>
          <th class="admin-table__actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        {MANAGED_PAGES.map((p) => (
          <tr>
            <td class="admin-table__title">{p.title}</td>
            <td><code class="admin-code">{p.url}</code></td>
            <td class="admin-table__actions">
              <a href={`/admin/pages/edit/?page=${p.slug}`} class="admin-link">Edit</a>
              <a href={p.url} target="_blank" rel="noopener" class="admin-link admin-link--muted">View</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>

<style>
  .admin-note { color: var(--color-muted); margin: 0 0 var(--space-5); }
  .admin-table-wrap {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow-x: auto;
  }
  .admin-table { width: 100%; border-collapse: collapse; font-size: var(--text-base); }
  .admin-table th, .admin-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }
  .admin-table th {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-widest);
    color: var(--color-muted);
    background: var(--color-surface);
  }
  .admin-table__title { font-weight: 600; }
  .admin-table__actions { white-space: nowrap; text-align: right; }
  .admin-code {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-sm);
    background: var(--color-surface);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
  .admin-link {
    color: var(--color-accent-strong);
    font-weight: 600;
    text-decoration: none;
    margin-left: var(--space-3);
  }
  .admin-link:hover { text-decoration: underline; }
  .admin-link--muted { color: var(--color-muted); }
</style>
