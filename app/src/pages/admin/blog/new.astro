---
/**
 * pages/admin/blog/new.astro — create a new blog post.
 * Owner: Admin.
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PostForm from "../../../components/admin/PostForm.astro";
---

<AdminLayout title="New Post" section="blog">
  <PostForm />

  <script>
    import { writeFile } from "../../../lib/admin-github";
    import { CONTENT_PATHS } from "../../../lib/admin-config";
    import { buildPost, slugify, type BlogFrontmatter } from "../../../lib/admin-frontmatter";

    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const form = document.getElementById("post-form") as HTMLFormElement;
    const err = document.getElementById("form-error")!;
    const status = document.getElementById("save-status")!;
    const btn = document.getElementById("save-btn") as HTMLButtonElement;

    // Default date = today
    ($("f-date") as HTMLInputElement).value = new Date().toISOString().slice(0, 10);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      err.hidden = true;
      btn.disabled = true;
      status.textContent = "Saving…";
      try {
        const fm: BlogFrontmatter = {
          title: $("f-title").value.trim(),
          description: ($("f-description") as HTMLTextAreaElement).value.trim(),
          date: $("f-date").value,
          category: $("f-category").value.trim(),
          image: $("f-image").value.trim(),
          draft: ($("f-draft") as HTMLInputElement).checked,
          noindex: ($("f-noindex") as HTMLInputElement).checked,
          tags: $("f-tags").value.split(",").map((t) => t.trim()).filter(Boolean),
        };
        const body = ($("f-body") as HTMLTextAreaElement).value;
        if (!fm.title || !fm.description || !body.trim()) throw new Error("Title, description and content are required.");

        const slug = slugify(fm.title);
        const path = `${CONTENT_PATHS.blogDir}/${slug}.md`;
        await writeFile(path, buildPost(fm, body), `Admin: new post "${fm.title}"`, null);

        status.textContent = "Saved! Redirecting…";
        setTimeout(() => (window.location.href = "/admin/blog/"), 800);
      } catch (ex: any) {
        err.textContent = "Save failed: " + (ex.message ?? ex);
        err.hidden = false;
        btn.disabled = false;
        status.textContent = "";
      }
    });
  </script>
</AdminLayout>
