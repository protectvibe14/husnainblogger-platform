---
/**
 * [hub].astro — MODERN REDESIGNED category hub pages (2026-10-08 v2).
 * Served at /tools/<categorySlug>-tools/
 *
 * Modern design: gradient hero, search/filter, beautiful tool cards
 * with descriptions, grouped by tool type with counts.
 */
import { CATEGORIES } from "../lib/registry/types";
import { byCategory, toolUrl } from "../data/registry.generated";
import { hubHref, toolsIndexHref } from "../../../config/site.config";
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/ads/AdSlot.astro";

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { hub: `${c.slug}-tools` },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const categoryTools = (byCategory[category.slug] ?? []).filter((t) => t.enabled !== false);

// Group by toolType
const byType = new Map<string, typeof categoryTools>();
for (const t of categoryTools) {
  const bucket = byType.get(t.toolType) ?? [];
  bucket.push(t);
  byType.set(t.toolType, bucket);
}

const hubName = category.name.endsWith('Tools') ? category.name : `${category.name} Tools`;
const title = `${hubName} — ${categoryTools.length} Free Online Tools`;
const description = `Free ${category.name.toLowerCase()} tools — ${categoryTools.length} online tools for ${category.name.toLowerCase()}. No signup, instant results, 100% private.`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={hubHref(category.slug)}
  activeNav="tools"
>
  <nav class="hb-crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href={toolsIndexHref()}>Tools</a></li>
      <li aria-current="page">{category.name}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <header class="hb-hub-hero">
    <div class="hb-hub-hero__inner">
      <span class="hb-hub-hero__eyebrow">{categoryTools.length} Free Tools</span>
      <h1 class="hb-hub-hero__title">{hubName}</h1>
      <p class="hb-hub-hero__desc">
        Professional-grade {category.name.toLowerCase()} tools that run entirely in your browser.
        No signup, no downloads — just instant results.
      </p>
      <div class="hb-hub-hero__search">
        <input
          type="search"
          id="hub-search"
          placeholder={`Search ${categoryTools.length} ${category.name.toLowerCase()} tools...`}
          aria-label={`Search ${category.name} tools`}
        />
      </div>
    </div>
  </header>

  <AdSlot slot="hub-top" />

  <!-- Tool groups -->
  <div id="hub-tools">
    {[...byType.entries()].map(([toolType, list]) => {
      const typeLabels: Record<string, string> = {
        ai: 'AI Tools', calculator: 'Calculators', generator: 'Generators',
        checker: 'Checkers', converter: 'Converters', analyzer: 'Analyzers',
        planner: 'Planners', tracker: 'Trackers', finder: 'Finders',
      };
      const typeLabel = typeLabels[toolType] ?? (toolType.charAt(0).toUpperCase() + toolType.slice(1) + 's');
      return (
      <section class="hb-hub-section" data-tooltype={toolType}>
        <div class="hb-hub-section__head">
          <h2>{typeLabel}</h2>
          <span class="hb-hub-section__count">{list.length} tools</span>
        </div>
        <div class="hb-hub-grid">
          {list.map((t) => (
            <a href={toolUrl(t)} class="hb-hub-card" data-tool-name={t.name.toLowerCase()}>
              <div class="hb-hub-card__top">
                <strong class="hb-hub-card__name">{t.name}</strong>
                <span class="hb-hub-card__arrow" aria-hidden="true">→</span>
              </div>
              <p class="hb-hub-card__desc">
                Free {t.primaryKeyword || t.name.toLowerCase()} — instant results, no signup.
              </p>
              <span class="hb-hub-card__tag">{t.toolType}</span>
            </a>
          ))}
        </div>
      </section>
      );
    })}
  </div>

  <AdSlot slot="hub-bottom" />

  <!-- SEO content -->
  <section class="hb-hub-seo">
    <h2>About {hubName}</h2>
    <p>
      Our collection of <strong>{categoryTools.length} free {category.name.toLowerCase()} tools</strong> covers
      everything from {[...byType.keys()].slice(0, 3).join(', ')} and more.
      Each tool is designed to be fast, private, and easy to use — no account required.
    </p>
    <p>
      Whether you're a professional, creator, or just need a quick solution,
      these browser-based tools deliver instant results. All tools are free forever
      with unlimited use.
    </p>
  </section>
</BaseLayout>

<script>
  // Live search filter
  const input = document.getElementById('hub-search') as HTMLInputElement;
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    document.querySelectorAll('.hb-hub-card').forEach((card) => {
      const name = (card as HTMLElement).dataset.toolName || '';
      (card as HTMLElement).style.display = name.includes(q) ? '' : 'none';
    });
    document.querySelectorAll('.hb-hub-section').forEach((section) => {
      const visible = [...section.querySelectorAll('.hb-hub-card')]
        .some((c) => (c as HTMLElement).style.display !== 'none');
      (section as HTMLElement).style.display = visible ? '' : 'none';
    });
  });
</script>

<style>
  .hb-crumbs { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
  .hb-crumbs ol { display: flex; gap: 0.5rem; list-style: none; padding: 1rem 0; margin: 0; font-size: 0.85rem; }
  .hb-crumbs li + li::before { content: "/"; margin-right: 0.5rem; color: #999; }
  .hb-crumbs a { color: #666; text-decoration: none; }

  .hb-hub-hero {
    background:
      radial-gradient(ellipse 80% 60% at 20% 10%, rgba(129,140,248,0.35) 0%, transparent 60%),
      radial-gradient(ellipse 70% 50% at 85% 90%, rgba(217,70,239,0.25) 0%, transparent 55%),
      linear-gradient(150deg, #1e1b4b 0%, #312e81 35%, #6d28d9 70%, #a21caf 100%);
    border-radius: 2rem; padding: 4rem 3rem; margin: 1.5rem auto 3rem;
    max-width: 1280px; color: white; text-align: center; position: relative; overflow: hidden;
    box-shadow: 0 25px 60px -15px rgba(109,40,217,0.4);
  }
  .hb-hub-hero::before {
    content: ""; position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none; opacity: 0.6;
  }
  .hb-hub-hero__inner { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .hb-hub-hero__eyebrow {
    display: inline-block; font-size: 0.8rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
    background: rgba(255,255,255,0.2); padding: 0.4rem 1rem;
    border-radius: 2rem; margin-bottom: 1rem;
  }
  .hb-hub-hero__title { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; margin: 0 0 1rem; }
  .hb-hub-hero__desc { font-size: 1.1rem; opacity: 0.92; margin: 0 0 1.75rem; line-height: 1.6; }
  .hb-hub-hero__search input {
    width: 100%; max-width: 480px; padding: 0.9rem 1.5rem; border-radius: 3rem;
    border: 2px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px); color: white; font-size: 1rem; outline: none;
  }
  .hb-hub-hero__search input::placeholder { color: rgba(255,255,255,0.7); }
  .hb-hub-hero__search input:focus { border-color: white; background: rgba(255,255,255,0.22); }

  #hub-tools { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
  .hb-hub-section { margin: 2.5rem 0; }
  .hb-hub-section__head {
    display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.25rem;
    border-bottom: 2px solid #f3f4f6; padding-bottom: 0.75rem;
  }
  .hb-hub-section__head h2 { font-size: 1.4rem; font-weight: 700; margin: 0; color: #111827; }
  .hb-hub-section__count {
    font-size: 0.85rem; color: #6b7280; background: #f3f4f6;
    padding: 0.25rem 0.75rem; border-radius: 2rem;
  }

  .hb-hub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .hb-hub-card {
    display: block; background: white; border: 1px solid #e5e7eb;
    border-radius: 1rem; padding: 1.4rem; text-decoration: none;
    transition: all 0.2s ease; position: relative;
  }
  .hb-hub-card:hover {
    transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,0.1);
    border-color: #7c3aed;
  }
  .hb-hub-card__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; }
  .hb-hub-card__name { color: #111827; font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .hb-hub-card__arrow { color: #7c3aed; font-weight: 700; flex-shrink: 0; transition: transform 0.2s; }
  .hb-hub-card:hover .hb-hub-card__arrow { transform: translateX(4px); }
  .hb-hub-card__desc { color: #6b7280; font-size: 0.88rem; margin: 0.6rem 0 0.75rem; line-height: 1.55; }
  .hb-hub-card__tag {
    display: inline-block; font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #7c3aed; background: #f5f3ff;
    padding: 0.25rem 0.7rem; border-radius: 2rem;
  }

  .hb-hub-seo { max-width: 800px; margin: 3rem auto; padding: 0 1.5rem; color: #374151; line-height: 1.75; }
  .hb-hub-seo h2 { color: #111827; font-size: 1.5rem; }

  @media (max-width: 640px) {
    .hb-hub-hero { padding: 2.5rem 1.25rem; margin: 0.75rem; }
    .hb-hub-grid { grid-template-columns: 1fr; }
  }
</style>
