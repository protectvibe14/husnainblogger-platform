---
/**
 * PopularTools.astro — trending/popular tools showcase for the landing page.
 * Owner: Landing.
 *
 * Shows hand-picked popular tools across categories with direct links.
 * Data comes from props (page owns the selection).
 */
import { toolHref } from "../../../../config/site.config";

interface PopularTool {
  name: string;
  slug: string;
  categorySlug: string;
  category: string;
  blurb: string;
}

interface Props {
  tools: PopularTool[];
}

const { tools } = Astro.props;
---

<section class="landing-section" aria-labelledby="landing-popular-title">
  <div class="landing-section__head">
    <span class="hb-tool-eyebrow">Most loved</span>
    <h2 id="landing-popular-title">Popular right now</h2>
    <p>The tools creators reach for every day — free, instant, no signup.</p>
  </div>
  <div class="landing-popular">
    {tools.map((t) => (
      <a href={toolHref({ categorySlug: t.categorySlug, slug: t.slug })} class="landing-tool-card">
        <span class="landing-tool-card__icon" aria-hidden="true">{t.name.charAt(0)}</span>
        <span class="landing-tool-card__body">
          <span class="landing-tool-card__name">{t.name}</span>
          <span class="landing-tool-card__blurb">{t.blurb}</span>
          <span class="landing-tool-card__cat">{t.category}</span>
        </span>
        <span class="landing-tool-card__arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<style>
  .landing-popular {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }
  .landing-tool-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.25s ease;
  }
  .landing-tool-card:hover {
    transform: translateY(-3px);
    box-shadow: rgb(238, 241, 245) 0px 0px 5px 5px;
    border-color: var(--color-accent);
  }
  .landing-tool-card__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 5px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-dark, #6d28d9));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    display: grid;
    place-items: center;
  }
  .landing-tool-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .landing-tool-card__name {
    font-weight: 600;
    font-size: var(--text-base);
  }
  .landing-tool-card__blurb {
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .landing-tool-card__cat {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-wide);
    color: var(--color-accent);
    margin-top: var(--space-1);
  }
  .landing-tool-card__arrow {
    color: var(--color-accent);
    font-weight: 700;
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.25s ease;
  }
  .landing-tool-card:hover .landing-tool-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
