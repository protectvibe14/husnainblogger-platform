---
/**
 * BrowseAllTools.astro — full tool directory for the landing page.
 * Owner: Landing.
 *
 * SmallSEOTools-style format: each category is a card with centered
 * heading + description, tools shown as icon tiles (icon on top,
 * name below) in a wrapped grid. Our colors/fonts, their proven format.
 */
import { hubHref, toolHref } from "../../../../config/site.config";

interface Tool {
  name: string;
  slug: string;
  categorySlug: string;
}

interface Category {
  name: string;
  slug: string;
  count: number;
  tagline: string;
  tools: Tool[];
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
const SHOW_PER_CAT = 12;
---

<section class="landing-section" aria-labelledby="landing-alltools-title">
  <div class="landing-section__head">
    <span class="hb-tool-eyebrow">Full directory</span>
    <h2 id="landing-alltools-title">Browse every tool</h2>
    <p>All {categories.reduce((n, c) => n + c.count, 0)} tools, organized by category. Click any tool to use it instantly.</p>
  </div>

  <div class="landing-directory">
    {categories.map((c) => (
      <div class="sst-cat">
        <h3 class="sst-cat__title">
          <a href={hubHref(c.slug)}>{c.name}</a>
        </h3>
        <p class="sst-cat__desc">{c.tagline}</p>
        <div class="sst-tools">
          {c.tools.slice(0, SHOW_PER_CAT).map((t) => (
            <a
              href={toolHref({ categorySlug: t.categorySlug, slug: t.slug })}
              class="sst-tool"
              title={t.name}
            >
              <span class="sst-tool__icon" aria-hidden="true">{t.name.charAt(0)}</span>
              <span class="sst-tool__name">{t.name}</span>
            </a>
          ))}
        </div>
        {c.count > SHOW_PER_CAT && (
          <a href={hubHref(c.slug)} class="sst-cat__more">
            View all {c.count} {c.name} tools →
          </a>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .landing-directory {
    display: grid;
    gap: var(--space-8);
  }
  /* Category card — clean white, centered heading like SmallSEOTools */
  .sst-cat {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8) var(--space-8) var(--space-7);
    box-shadow: var(--shadow-sm);
  }
  .sst-cat__title {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    letter-spacing: var(--letter-tight);
  }
  .sst-cat__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .sst-cat__title a:hover {
    color: var(--color-accent);
  }
  .sst-cat__desc {
    text-align: center;
    color: var(--color-muted);
    font-size: var(--text-base);
    max-width: 60ch;
    margin: 0 auto var(--space-7);
    line-height: var(--leading-normal);
  }
  /* Tool icon tiles — icon on top, name below */
  .sst-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  .sst-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 104px;
    padding: var(--space-4) var(--space-2);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .sst-tool:hover {
    background: var(--color-surface);
    transform: translateY(-3px);
  }
  .sst-tool__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--gradient-gold);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-gold);
    transition: transform 0.18s ease;
  }
  .sst-tool:hover .sst-tool__icon {
    transform: scale(1.08);
  }
  .sst-tool__name {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sst-tool:hover .sst-tool__name {
    color: var(--color-accent);
  }
  .sst-cat__more {
    display: block;
    text-align: center;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }
  .sst-cat__more:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .sst-cat { padding: var(--space-6) var(--space-4); }
    .sst-tool { width: 88px; }
    .sst-tool__icon { width: 44px; height: 44px; font-size: var(--text-lg); }
  }
</style>
