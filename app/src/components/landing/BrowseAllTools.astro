---
/**
 * BrowseAllTools.astro — SmallSEOTools-format tool directory.
 * Owner: Landing.
 *
 * Design per SST design system (colors/fonts = ours):
 * - 4px base spacing unit, 5px border radius (friendly, rounded)
 * - Cards: white bg, subtle shadow rgb(238,241,245) 0 0 5px 5px
 * - Compact, restrained type (H2 20px)
 * - 5-per-row icon tiles, ad banners between categories
 */
import { hubHref, toolHref } from "../../../../config/site.config";
import AdSlot from "../ads/AdSlot.astro";
import CategoryIcon from "./CategoryIcon.astro";

interface Tool {
  name: string;
  slug: string;
  categorySlug: string;
}

interface Category {
  name: string;
  slug: string;
  count: number;
  tagline: string;
  tools: Tool[];
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<div class="sst-directory">
  {categories.map((c, ci) => (
    <>
      <section class="sst-category" aria-labelledby={`sst-cat-${c.slug}`}>
        <h2 id={`sst-cat-${c.slug}`} class="sst-category__title">
          <a href={hubHref(c.slug)}>{c.name}</a>
        </h2>
        <p class="sst-category__desc">{c.tagline}</p>
        <div class="sst-tiles">
          {c.tools.map((t) => (
            <a
              href={toolHref({ categorySlug: t.categorySlug, slug: t.slug })}
              class="sst-tile"
              title={t.name}
            >
              <span class="sst-tile__icon" aria-hidden="true"><CategoryIcon slug={t.categorySlug} /></span>
              <span class="sst-tile__name">{t.name}</span>
            </a>
          ))}
        </div>
      </section>
      {/* Ad banner after every category */}
      {ci < categories.length - 1 && (
        <div class="sst-ad-between">
          <AdSlot slot={ci % 2 === 0 ? "hub-top" : "hub-bottom"} />
        </div>
      )}
    </>
  ))}
</div>

<style>
  /* 4px base unit, 5px radius, subtle SST shadow */
  .sst-directory {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sst-category {
    background: #ffffff;
    border-radius: 5px;
    padding: 24px 16px;
    box-shadow: rgb(238, 241, 245) 0px 0px 5px 5px;
  }
  .sst-category__title {
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 24px;
    margin: 0 0 8px;
  }
  .sst-category__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .sst-category__title a:hover {
    color: var(--color-accent);
  }
  .sst-category__desc {
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted);
    max-width: 62ch;
    margin: 0 auto 16px;
    line-height: 23px;
  }
  /* 5-per-row tiles, 4px grid */
  .sst-tiles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .sst-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 4px;
    border-radius: 5px;
    text-decoration: none;
    min-height: 44px;
    transition: background 0.15s ease;
  }
  .sst-tile:hover {
    background: var(--color-surface);
  }
  .sst-tile__icon {
    width: 50px;
    height: 50px;
    border: 1px solid #dddddd;
    border-radius: 5px;
    background: #ffffff;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 20px;
    display: grid;
    place-items: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .sst-tile:hover .sst-tile__icon {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .sst-tile__name {
    font-size: 12px;
    font-weight: 400;
    color: var(--color-text);
    text-align: center;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
  }
  .sst-tile:hover .sst-tile__name {
    color: var(--color-accent);
  }
  .sst-ad-between {
    margin: 8px 0;
  }
  .sst-ad-between:empty {
    display: none;
  }
  /* Responsive: SST breakpoints */
  @media (max-width: 1024px) {
    .sst-tiles { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 640px) {
    .sst-tiles { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .sst-category { padding: 16px 12px; }
    .sst-category__title { font-size: 18px; }
    .sst-tile { min-height: 44px; min-width: 44px; }
    .sst-tile__icon { width: 44px; height: 44px; }
  }
</style>
