---
/**
 * CategoryIcon.astro — SST-style line icons per category.
 * Owner: Landing.
 *
 * Simple stroke icons in accent color (our color, SST's line style).
 * One icon per category — clean and consistent like SmallSEOTools.
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const icons: Record<string, string> = {
  // blogging-seo: document with pencil
  "blogging-seo": '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15l1.5 1.5L16 11"/>',
  // make-money: dollar coin
  "make-money": '<circle cx="12" cy="12" r="9"/><path d="M12 7v10"/><path d="M15 9.5c-.7-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2.5 0 3.5 6 1.8 6 5.3 0 1.6-1.3 2.5-3 2.5-1.3 0-2.3-.5-3-1.5"/>',
  // youtube: play button
  "youtube": '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z"/>',
  // tiktok: music note
  "tiktok": '<path d="M9 18V5l10-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
  // instagram: camera
  "instagram": '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>',
  // video-editing: film strip
  "video-editing": '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5"/>',
  // ai-workflows: chip/cpu
  "ai-workflows": '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M10 2v3M14 2v3M10 19v3M14 19v3M2 10h3M2 14h3M19 10h3M19 14h3"/>',
  // email-marketing: envelope
  "email-marketing": '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/>',
  // creator-business: briefcase
  "creator-business": '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M2 12h20"/>',
  // ai-tools: sparkles
  "ai-tools": '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/>',
  // pinterest-social: pin
  "pinterest-social": '<path d="M12 2a7 7 0 0 0-7 7c0 2.4 1.2 4.2 3 5.4V22l4-2 4 2v-7.6c1.8-1.2 3-3 3-5.4a7 7 0 0 0-7-7z"/><circle cx="12" cy="9" r="2.5"/>',
};

const path = icons[slug] ?? icons["ai-tools"];
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="cat-icon"
>
  <g set:html={path} />
</svg>

<style>
  .cat-icon {
    width: 28px;
    height: 28px;
  }
</style>
