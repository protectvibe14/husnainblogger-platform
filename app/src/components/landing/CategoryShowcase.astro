---
/**
 * CategoryShowcase.astro — visual category grid for the landing page.
 * Owner: Landing.
 *
 * Each card: icon (emoji-free, uses a gold monogram letter), name,
 * tool count, and arrow affordance. Data comes from props (the page
 * owns the registry query).
 */
import { hubHref } from "../../../../config/site.config";

interface Category {
  name: string;
  slug: string;
  count: number;
  tagline: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="landing-section" aria-labelledby="landing-cats-title">
  <div class="landing-section__head">
    <span class="hb-tool-eyebrow">Browse by category</span>
    <h2 id="landing-cats-title">Built for every creator</h2>
    <p>Eleven specialized toolkits. Pick yours — or explore them all.</p>
  </div>
  <div class="landing-cats">
    {categories.map((c) => (
      <a href={hubHref(c.slug)} class="landing-cat">
        <span class="landing-cat__icon" aria-hidden="true">{c.name.charAt(0)}</span>
        <span class="landing-cat__body">
          <span class="landing-cat__name">{c.name}</span>
          <span class="landing-cat__tagline">{c.tagline}</span>
          <span class="landing-cat__count">{c.count} tools</span>
        </span>
        <span class="landing-cat__arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<style>
  .landing-section {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-20) var(--space-6);
  }
  .landing-section__head {
    text-align: center;
    max-width: var(--content-narrow);
    margin: 0 auto var(--space-12);
  }
  .landing-section__head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, var(--text-4xl));
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    margin: var(--space-4) 0 var(--space-3);
  }
  .landing-section__head p {
    color: var(--color-muted);
    font-size: var(--text-lg);
    margin: 0;
  }
  .landing-cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-5);
  }
  .landing-cat {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .landing-cat::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-gold);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .landing-cat:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }
  .landing-cat:hover::before { opacity: 1; }
  .landing-cat__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--gradient-gold);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-gold);
  }
  .landing-cat__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .landing-cat__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .landing-cat__tagline {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .landing-cat__count {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-wide);
    color: var(--color-accent);
    margin-top: var(--space-1);
  }
  .landing-cat__arrow {
    color: var(--color-accent);
    font-weight: 700;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.25s ease;
  }
  .landing-cat:hover .landing-cat__arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
