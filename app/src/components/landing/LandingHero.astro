---
/**
 * LandingHero.astro — the landing page hero section.
 * Owner: Landing.
 *
 * Full-viewport editorial hero: eyebrow badge, serif display headline,
 * subheadline, dual CTAs (browse tools / search), and live stats row
 * (tool count, categories, cost, signup). Stats come from props so the
 * page owns the data.
 */
interface Props {
  toolCount: number;
  categoryCount: number;
}

const { toolCount, categoryCount } = Astro.props;
---

<section class="landing-hero" aria-labelledby="landing-hero-title">
  <div class="landing-hero__inner">
    <h1 id="landing-hero-title" class="landing-hero__title">
      Free Online Tools for Creators
    </h1>
    <p class="landing-hero__sub">
      {toolCount} free tools across {categoryCount} categories — no signup, no paywalls.
      Everything runs in your browser.
    </p>
    <form class="landing-hero__search" action="/search/" method="get" role="search" aria-label="Search tools">
      <svg class="landing-hero__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Search 569 tools… try &quot;fee calculator&quot; or &quot;hashtag&quot;"
        aria-label="Search tools"
        autocomplete="off"
      />
      <button type="submit">Search</button>
    </form>
  </div>
</section>

<style>
  .landing-hero {
    position: relative;
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
    overflow: hidden;
  }
  .landing-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent),
      var(--gradient-hero);
    z-index: -1;
  }
  .landing-hero__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .landing-hero__title {
    font-size: 26px;
    font-weight: 700;
    line-height: 31px;
    margin: 0 0 var(--space-3);
  }
  .landing-hero__sub {
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    max-width: 58ch;
    margin: 0 auto var(--space-6);
  }
  .landing-hero__search {
    display: flex;
    align-items: center;
    max-width: 560px;
    margin: 0 auto;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 5px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    box-shadow: var(--shadow-md);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .landing-hero__search:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 15%, transparent), var(--shadow-md);
  }
  .landing-hero__search-icon {
    width: 20px;
    height: 20px;
    color: var(--color-muted);
    flex-shrink: 0;
    margin-right: var(--space-3);
  }
  .landing-hero__search input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--text-base);
    color: var(--color-text);
    outline: none;
    min-width: 0;
  }
  .landing-hero__search input::placeholder {
    color: var(--color-muted);
  }
  .landing-hero__search button {
    background: var(--gradient-gold);
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: var(--space-3) var(--space-6);
    font-weight: 700;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
  }
  .landing-hero__search button:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
  @media (max-width: 640px) {
    .landing-hero { padding: var(--space-8) 0 var(--space-6); }
  }
</style>
