---
/**
 * components/ads/AdSlot.astro — renders one ad slot.
 * Owner: Ads.
 *
 * Reads data/ads-config.json at build time. Renders nothing when the
 * slot is disabled or has no code. Ad code is injected via set:html
 * (admin-pasted AdSense/script tags).
 *
 * SECURITY: ad code executes with full page privileges (XSS surface).
 * scripts/validate-ads.mjs allowlists ad-network domains at build time
 * and fails the build on javascript: URIs, inline event handlers, and
 * <object>/<embed>/<form> tags. Trust model: docs/security/ADS_TRUST_MODEL.md
 *
 * Props:
 *   slot — key in ads-config.json (e.g. "tool-top")
 */
import adsConfig from "../../../../data/ads-config.json";

interface Props {
  slot: string;
}

const { slot } = Astro.props;
const cfg = (adsConfig.slots as Record<string, any>)[slot];

const show = cfg?.enabled && cfg?.code?.trim();
// Show a visible placeholder when no ad is configured — so the owner
// can see exactly where ad spaces are. Real ad code replaces this.
const showPlaceholder = !show;
// Device targeting: honor the admin panel's "devices" setting ("both" | "desktop" | "mobile").
const devices = cfg?.devices === "desktop" || cfg?.devices === "mobile" ? cfg.devices : "both";
---

{show && (
  <div class={`hb-ad-slot hb-ad-slot--${slot} hb-ad-slot--dev-${devices}`} data-ad-slot={slot} role="complementary" aria-label="Advertisement">
    <span class="hb-ad-label">Advertisement</span>
    <div class="hb-ad-body" set:html={cfg.code} />
  </div>
)}

{showPlaceholder && (
  <div class={`hb-ad-slot hb-ad-slot--placeholder hb-ad-slot--${slot} hb-ad-slot--dev-${devices}`} data-ad-slot={slot} role="complementary" aria-label="Ad space">
    <span class="hb-ad-label">Advertisement</span>
    <div class="hb-ad-placeholder">
      <span>Ad Space — {slot}</span>
      <small>Add your ad code in Admin → Ads</small>
    </div>
  </div>
)}

{/* Sticky mobile compensation: keep the fixed banner from covering the footer/content */}
{show && slot === "tool-sticky-mobile" && (
  <style is:global>
    @media (max-width: 768px) {
      body { padding-bottom: 76px; }
    }
  </style>
)}

<style>
  .hb-ad-slot {
    margin: var(--space-6) auto;
    max-width: 970px;
    text-align: center;
  }
  .hb-ad-label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
    font-family: var(--font-sans);
  }
  .hb-ad-body {
    display: flex;
    justify-content: center;
  }
  .hb-ad-body ins, .hb-ad-body iframe {
    max-width: 100%;
  }
  /* Sidebar slots are narrower */
  .hb-ad-slot--tool-sidebar-top,
  .hb-ad-slot--tool-sidebar-bottom {
    margin: 0;
  }
  /* Placeholder: visible ad space when no ad code configured */
  .hb-ad-slot--placeholder {
    margin: var(--space-4) auto;
  }
  .hb-ad-placeholder {
    border: 2px dashed var(--color-border);
    border-radius: 5px;
    background: var(--color-surface);
    padding: 32px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
  }
  .hb-ad-placeholder span {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-muted);
  }
  .hb-ad-placeholder small {
    font-size: 12px;
    color: var(--color-muted);
    opacity: 0.7;
  }
  /* Sidebar placeholders are narrower */
  .hb-ad-slot--tool-sidebar-top .hb-ad-placeholder,
  .hb-ad-slot--tool-sidebar-bottom .hb-ad-placeholder {
    padding: 48px 12px;
  }
  /* Sticky mobile: fixed bottom, mobile only */
  .hb-ad-slot--tool-sticky-mobile {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 60;
    margin: 0;
    padding: var(--space-2);
    background: color-mix(in srgb, var(--color-surface) 95%, transparent);
    border-top: 1px solid var(--color-border);
    display: none;
  }
  @media (max-width: 768px) {
    .hb-ad-slot--tool-sticky-mobile { display: block; }
  }
  /* Device targeting from admin panel: "desktop" hides on mobile, "mobile" hides on desktop */
  @media (max-width: 768px) {
    .hb-ad-slot--dev-desktop { display: none; }
  }
  @media (min-width: 769px) {
    .hb-ad-slot--dev-mobile { display: none; }
  }
</style>
