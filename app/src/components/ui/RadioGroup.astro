---
/**
 * RadioGroup.astro — native radios in <fieldset>/<legend> + hint + error.
 * Owner: MA1-DesignSystem.
 *
 * 1.3.1: the group relationship is programmatic via fieldset/legend — never
 * a bare div of radios. Error/hint are described on the GROUP (error id on
 * the fieldset's aria-describedby + aria-invalid on each radio would be
 * noise; instead the group carries the description and each radio remains
 * individually labelled).
 */
import { nextId } from "../../lib/a11y/ids";

interface RadioOption {
  value: string;
  label: string;
  hint?: string;
  disabled?: boolean;
}

interface Props {
  name: string;
  /** Visible group label — required (the <legend>). */
  legend: string;
  options: RadioOption[];
  value?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  describedBy?: string;
  disabled?: boolean;
  class?: string;
}

const {
  name, legend, options, value, hint, error,
  required = false, describedBy, disabled = false, class: cls,
} = Astro.props;

const groupId = nextId("radiogroup");
const hintId = hint ? `${groupId}-hint` : undefined;
const errorId = error ? `${groupId}-error` : undefined;
const describedby = [hintId, errorId, describedBy].filter(Boolean).join(" ") || undefined;
---
<fieldset
  class:list={["hb-fieldset", "hb-field", cls]}
  aria-describedby={describedby}
  aria-invalid={error ? "true" : undefined}
  disabled={disabled || undefined}
>
  <legend class="hb-fieldset__legend">
    {legend}
    {required ? <span class="hb-field__marker hb-field__marker--required">required</span> : null}
  </legend>
  {hint && <p class="hb-field__hint" id={hintId}>{hint}</p>}
  {options.map((opt, i) => {
    const id = `${groupId}-opt-${i}`;
    return (
      <div class="hb-choice">
        <input
          class="hb-choice__input"
          type="radio"
          id={id}
          name={name}
          value={opt.value}
          checked={value === opt.value || undefined}
          required={required || undefined}
          disabled={opt.disabled || undefined}
        />
        <label class="hb-choice__label" for={id}>{opt.label}</label>
        {opt.hint && <p class="hb-choice__hint">{opt.hint}</p>}
      </div>
    );
  })}
  {error && (
    <p class="hb-field__error" id={errorId}>
      <svg class="hb-field__error-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.75"/>
        <path d="M8 4.5v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        <circle cx="8" cy="11.25" r="1" fill="currentColor"/>
      </svg>
      <span><strong>{legend}:</strong> {error}</span>
    </p>
  )}
</fieldset>
