---
/**
 * layouts/BaseLayout.astro — THE shared page shell for HusnainBlogger.
 * Owner: Platform.
 *
 * Every public page MUST use this layout. Site-wide chrome lives ONLY here:
 *   - <head> SEO meta (title, description, canonical, robots, Open Graph, Twitter Card)
 *   - site header (brand + main nav with active-state)
 *   - site footer
 *
 * To change the header, nav, or footer site-wide: edit THIS file only.
 * Page-specific <head> extras (e.g. article:published_time) go in the
 * `head` slot. Page-specific styles stay in the page (scoped <style>).
 *
 * Props:
 *   title        full <title> string
 *   description  meta description
 *   canonical    absolute canonical URL
 *   robots       default "index, follow"
 *   ogType       default "website"
 *   ogImage      absolute og:image URL (optional)
 *   activeNav    highlights one nav item: "tools" | "blog" | "video" | "ai" | null
 */
import "../styles/luxury.css";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  activeNav?: "tools" | "blog" | "video" | "ai" | null;
}

const {
  title,
  description,
  canonical,
  robots = "index, follow",
  ogType = "website",
  ogImage,
  activeNav = null,
} = Astro.props;

const nav = [
  { href: "/tools/", label: "All Tools", key: "tools" },
  { href: "/blog/", label: "Blog", key: "blog" },
  { href: "/tools/video-editing-tools/", label: "Video", key: "video" },
  { href: "/tools/ai-tools-tools/", label: "AI Tools", key: "ai" },
] as const;

// Analytics: Google Analytics 4 (GA4).
// Priority: 1) data/site-settings.json → ga4MeasurementId (admin panel),
// 2) PUBLIC_GA4_MEASUREMENT_ID env var (Vercel dashboard).
// Format: G-XXXXXXXXXX. The script renders ONLY when an ID is set.
// The Measurement ID is public by design (visible in page source).
import siteSettings from "../../../data/site-settings.json";const ga4MeasurementId = (
  (siteSettings as any).ga4MeasurementId?.trim() ||
  (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? "").trim()
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
    {/* Google Analytics 4 — renders only when PUBLIC_GA4_MEASUREMENT_ID is set.
        async = non-render-blocking. Standard GA4 gtag.js snippet. */}
    {ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`} />
        <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4MeasurementId}');`} />
      </>
    )}
  </head>
  <body>
    <header class="hb-site-header">
      <div class="hb-site-header__inner">
        <a href="/" class="hb-brand">
          <span class="hb-brand__mark">H</span>
          HusnainBlogger
        </a>
        <nav class="hb-nav" aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={activeNav === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="hb-site-footer">
      <div class="hb-site-footer__inner">
        <nav class="hb-site-footer__links" aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/sitemap-page/">Sitemap</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms-and-conditions/">Terms</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/cookies-policy/">Cookies</a>
          <a href="/dmca/">DMCA</a>
        </nav>
        <span>© 2027 HusnainBlogger. Free tools for creators.</span>
        <span>Made with precision for the creator economy.</span>
      </div>
    </footer>

    <CookieConsent />
  </body>
</html>
