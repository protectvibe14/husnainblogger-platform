---
/**
 * layouts/AdminLayout.astro — premium admin shell with sidebar.
 * Owner: Admin.
 *
 * Used by all /admin/* pages (except login). Sidebar nav, topbar,
 * content area. Luxury design system. Auth is checked client-side
 * (see lib/admin-auth.ts) — each page includes the guard script.
 *
 * Props:
 *   title    page title shown in topbar + <title>
 *   section  active sidebar key: "dashboard" | "blog" | "tools" | "pages" | "media" | "settings"
 */
import "../styles/luxury.css";

interface Props {
  title: string;
  section: "dashboard" | "blog" | "tools" | "pages" | "media" | "settings";
}

const { title, section } = Astro.props;

const items = [
  { href: "/admin/", label: "Dashboard", key: "dashboard", icon: "◈" },
  { href: "/admin/blog/", label: "Blog Posts", key: "blog", icon: "✎" },
  { href: "/admin/tools/", label: "Tools", key: "tools", icon: "⚙" },
  { href: "/admin/pages/", label: "Pages", key: "pages", icon: "▤" },
  { href: "/admin/media/", label: "Media", key: "media", icon: "🖼" },
  { href: "/admin/ads/", label: "Ads", key: "ads", icon: "💰" },
  { href: "/admin/settings/", label: "Settings", key: "settings", icon: "☰" },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — HusnainBlogger Admin</title>
  </head>
  <body class="admin">
    <aside class="admin-sidebar">
      <a href="/admin/" class="admin-brand">
        <span class="hb-brand__mark">H</span>
        <span class="admin-brand__text">HusnainBlogger<em>Admin</em></span>
      </a>
      <nav class="admin-nav" aria-label="Admin">
        {items.map((item) => (
          <a
            href={item.href}
            class={`admin-nav__link${section === item.key ? " is-active" : ""}`}
            aria-current={section === item.key ? "page" : undefined}
          >
            <span class="admin-nav__icon" aria-hidden="true">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="admin-sidebar__foot">
        <a href="/" class="admin-nav__link" target="_blank" rel="noopener">
          <span class="admin-nav__icon" aria-hidden="true">↗</span>
          View site
        </a>
        <button class="admin-nav__link admin-logout" id="admin-logout" type="button">
          <span class="admin-nav__icon" aria-hidden="true">⏻</span>
          Log out
        </button>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <h1>{title}</h1>
        <span class="admin-topbar__user">Administrator</span>
      </header>
      <main class="admin-content">
        <slot />
      </main>
    </div>

    <script>
      // Auth guard: redirect to login if no session.
      if (!localStorage.getItem("hb_admin_session")) {
        window.location.href = "/admin/login/";
      }
      document.getElementById("admin-logout")?.addEventListener("click", () => {
        localStorage.removeItem("hb_admin_session");
        localStorage.removeItem("hb_admin_token");
        window.location.href = "/admin/login/";
      });
    </script>
  </body>
</html>

<style>
  .admin {
    display: flex;
    min-height: 100vh;
    background: var(--color-bg);
    color: var(--color-text);
    margin: 0;
  }
  .admin-sidebar {
    width: 260px;
    flex-shrink: 0;
    background: var(--color-ink);
    color: var(--color-on-ink);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .admin-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6);
    text-decoration: none;
    color: var(--color-on-ink);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .admin-brand__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.2;
    display: flex;
    flex-direction: column;
  }
  .admin-brand__text em {
    font-style: normal;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--letter-widest);
    color: #c9a961;
  }
  .admin-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    flex: 1;
  }
  .admin-nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: rgba(250, 249, 247, 0.72);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-base);
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.18s ease;
  }
  .admin-nav__link:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-on-ink);
  }
  .admin-nav__link.is-active {
    background: var(--gradient-gold);
    color: #fff;
    font-weight: 600;
  }
  .admin-nav__icon {
    width: 1.4em;
    text-align: center;
    font-size: var(--text-lg);
  }
  .admin-sidebar__foot {
    padding: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .admin-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-8);
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .admin-topbar h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--letter-tight);
    margin: 0;
  }
  .admin-topbar__user {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
  }
  .admin-content {
    padding: var(--space-8);
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
  }
  @media (max-width: 760px) {
    .admin-sidebar { width: 72px; }
    .admin-brand__text, .admin-nav__link { font-size: 0; }
    .admin-nav__link { justify-content: center; }
    .admin-nav__icon { font-size: var(--text-xl); }
    .admin-brand { justify-content: center; padding: var(--space-4); }
    .admin-content { padding: var(--space-4); }
  }
</style>
